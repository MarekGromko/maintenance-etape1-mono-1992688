{
    "compilerOptions": {
        "target": "ES2020",
        "module": "es2015",

        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,

        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}